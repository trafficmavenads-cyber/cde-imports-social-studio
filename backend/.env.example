# Copie para um ambiente privado no servidor, NUNCA envie valores reais ao GitHub.
PORT=8080
SITE_URL=https://trafficmavenads-cyber.github.io/cde-imports-social-studio/
BACKEND_URL=https://seu-backend.exemplo.com
DATA_DIR=/var/data
# Senha de acesso ao painel (minimo 16 caracteres)
ADMIN_PASSWORD=
# Chave aleatoria em hexadecimal de 32 bytes, gerada com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Meta / Instagram API with Instagram Login
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# TikTok developers - Login Kit (scope de publicacao depende de revisao da app)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic

# Pinterest developers
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_SCOPES=user_accounts:read,boards:read,pins:read,pins:write

# Google Cloud OAuth web client - YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.upload
