# Copy to .env on your PRIVATE machine. NEVER commit real credentials or session files.
HOST=127.0.0.1
PORT=3888
WA_ADMIN_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
WA_DATA_DIR=./private-data
WA_CONNECT_ENABLED=false
WA_SEND_ENABLED=false
# Group IDs are discovered AFTER manual WhatsApp authorization. Not invite URLs.
WA_ALLOWED_GROUP_IDS=
